# Runtime environment
ENV=development
LOG_LEVEL=INFO

# Storage directories
DATA_DIR=storage/data
FEATURES_DIR=storage/features
MODEL_DIR=storage/models
RL_DIR=storage/rl

# CORS configuration (comma separated)
CORS_ALLOW_ORIGINS=*

# Optional broker credentials (not required for demo)
BROKER_API_KEY=
BROKER_API_SECRET=
